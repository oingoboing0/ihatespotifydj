async def get_liked_songs(session):
    if 'access_token' not in session:
        return redirect('/login')
    
    if datetime.now().timestamp() > session['expires_at']:
        return redirect('/refresh-token')
    
    headers = {'Authorization': f"Bearer {session['access_token']}"}
    liked = {"items": []}  # Initialize liked to accumulate all tracks
    offset = 0
    limit = 50  # Maximum allowed items per request
    
    async with aiohttp.ClientSession() as session:
        while True:
            url = f"{API_BASE_URL}/me/tracks?limit={limit}&offset={offset}"
            response = await fetch(session, url, headers=headers)
            if 'error' in response:
                return jsonify({"error": f"Error in response: {response}"})
            if not response.get("items"):
                break  # No more tracks to fetch
            
            liked["items"].extend(response.get("items"))
            offset += limit
            
            # Optionally break if there's no next page indicated
            if not response.get("next"):
                break
    
    track_data = liked
    print(track_data.get("names", []))
    return jsonify({"tracks": track_data})

